# Go High Level OAuth 2.0 credentials
# Create your app at: https://marketplace.gohighlevel.com/
GHL_CLIENT_ID=your_ghl_client_id
GHL_CLIENT_SECRET=your_ghl_client_secret
GHL_REDIRECT_URI=http://localhost:3000/auth/callback

# Session secret (use a long random string in production)
SESSION_SECRET=change-this-to-a-random-secret-string

# App config
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
